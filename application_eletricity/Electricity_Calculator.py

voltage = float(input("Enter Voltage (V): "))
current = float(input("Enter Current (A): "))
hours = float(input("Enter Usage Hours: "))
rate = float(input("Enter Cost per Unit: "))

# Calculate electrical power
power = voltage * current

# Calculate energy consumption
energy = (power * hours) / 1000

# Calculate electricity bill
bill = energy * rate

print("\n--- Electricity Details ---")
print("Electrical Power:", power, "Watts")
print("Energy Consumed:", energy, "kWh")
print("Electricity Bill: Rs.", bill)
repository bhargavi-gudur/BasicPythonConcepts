print("Electricity Calculator")

voltage = float(input("Enter Voltage (V): "))
current = float(input("Enter Current (A): "))
hours = float(input("Enter Usage Hours: "))
rate = float(input("Enter Cost per Unit: "))

# Calculate electrical power
power = voltage * current

# Calculate energy consumption
energy = (power * hours) / 1000

# Calculate electricity bill
bill = energy * rate

print("\n--- Electricity Details ---")
print("Electrical Power:", power, "Watts")
print("Energy Consumed:", energy, "kWh")
print("Electricity Bill: Rs.", bill)